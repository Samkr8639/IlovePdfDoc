{
  "name": "@paperflow/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "dev:staging": "cross-env NODE_ENV=staging tsx watch src/index.ts",
    "dev:prod": "cross-env NODE_ENV=production tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:staging": "cross-env NODE_ENV=staging node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@paperflow/contracts": "*",
    "@types/multer": "^2.3.0",
    "cors": "^2.8.5",
    "docx": "^9.14.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jszip": "^3.10.2",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "pngjs": "^7.0.0",
    "pptxgenjs": "^4.0.0",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.0"
  }
